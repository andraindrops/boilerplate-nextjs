{
  "name": "boilerplate-nextjs",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "test": "dotenv -e .env.test -- prisma db push --force-reset && dotenv -e .env.test -- vitest run --passWithNoTests",
    "test:coverage": "dotenv -e .env.test -- prisma db push --force-reset && dotenv -e .env.test -- vitest run --coverage",
    "e2e-test": "dotenv -e .env.test -- prisma db push --force-reset && dotenv -e .env.test -- tsx tests/e2e/seed.ts && dotenv -e .env.test -- playwright test",
    "format": "biome format --write",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.6",
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.2.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/blob": "^2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@clerk/testing": "^2.0.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
